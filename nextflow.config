    name            = 'nf-core/spatialvi'
    contributors    = [
        [
            name: 'Erik Fasterius',
            affiliation: 'National Bioinformatics Infrastructure Sweden',
            email: '',
            github: '',
            contribution: ['author', 'maintainer'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: ' Christophe Avenel',
            affiliation: 'National Bioinformatics Infrastructure Sweden',
            email: '',
            github: '',
            contribution: ['author', 'maintainer'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: ' Sergii Domanskyi',
            affiliation: 'Jackson Laboratory',
            email: '',
            github: '',
            contribution: ['contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: ' Jeffrey Chuang',
            affiliation: 'Jackson Laboratory',
            email: '',
            github: '',
            contribution: ['contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: ' Anuj Srivastava',
            affiliation: 'Jackson Laboratory',
            email: '',
            github: '',
            contribution: ['contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/nf-core/spatialvi'
    description     = """10X Visium Spatial Transcriptomics"""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
