nextflow_process {

    name "Test Process SCANPY_HARMONY"
    script "../main.nf"
    process "SCANPY_HARMONY"

    tag "modules"
    tag "modules_local"
    tag "scanpy_harmony"

    test("homo_sapiens - h5ad") {

        setup {
            run("SCANPY_PCA") {
                script "../../pca/main.nf"
                process {
                    """
                    input[0] = channel.fromList([
                        tuple([ id: 'test_1' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)),
                        tuple([ id: 'test_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true))
                    ])
                    input[1] = 50   // n_pcs
                    input[2] = true // use_highly_variable
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SCANPY_PCA.out.adata
                    .map{ _meta, h5ad -> h5ad }
                    .collect()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("homo_sapiens - h5ad - stub") {

        options "-stub"

        setup {
            run("SCANPY_PCA") {
                script "../../pca/main.nf"
                process {
                    """
                    input[0] = channel.fromList([
                        tuple([ id: 'test_1' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)),
                        tuple([ id: 'test_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true))
                    ])
                    input[1] = 50   // n_pcs
                    input[2] = true // use_highly_variable
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SCANPY_PCA.out.adata
                    .map{ _meta, h5ad -> h5ad }
                    .collect()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
