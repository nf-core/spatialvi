nextflow_process {

    name "Test Process SCANPY_HARMONY"
    script "../main.nf"
    process "SCANPY_HARMONY"

    tag "modules"
    tag "modules_local"
    tag "scanpy_harmony"

    test("homo_sapiens - h5ad") {

        setup {
            run("SCANPY_PCA") {
                script "../../pca/main.nf"
                process {
                    """
                    input[0] = channel.fromList([
                        tuple([ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)),
                        tuple([ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2.2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true))
                    ])
                    input[1] = 50      // n_pcs
                    input[2] = false   // use_highly_variable
                    input[3] = 'X_pca' // key_added
                    input[4] = true    // write_adata
                    """
                }
            }
            run("ADATA_MERGE") {
                script "../../../adata/merge/main.nf"
                process {
                    """
                    input[0] = SCANPY_PCA.out.adata
                        .map { _meta, h5ad -> h5ad }
                        .collect()
                    input[1] = 'inner'      // join
                    input[2] = 'library_id' // label
                    input[3] = false        // preserve_spatial
                    input[4] = ''           // layer
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = ADATA_MERGE.out.adata
                    .map { h5ad -> [[id: "harmony"], h5ad] }
                input[1] = 'library_id' // key
                input[2] = 'X_pca'      // basis
                input[3] = 'X_harmony'  // embedding_added
                input[4] = true         // write_adata
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    anndata(process.out.adata[0][1]).yaml,
                    process.out.obsm.collect { _, path -> file(path).name }.sort()
                ).match() }
            )
        }
    }

    test("homo_sapiens - h5ad - custom basis") {

        setup {
            run("SCANPY_PCA") {
                script "../../pca/main.nf"
                process {
                    """
                    input[0] = channel.fromList([
                        tuple([ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)),
                        tuple([ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2.2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true))
                    ])
                    input[1] = 50             // n_pcs
                    input[2] = false          // use_highly_variable
                    input[3] = 'X_pca_merged' // key_added
                    input[4] = true           // write_adata
                    """
                }
            }
            run("ADATA_MERGE") {
                script "../../../adata/merge/main.nf"
                process {
                    """
                    input[0] = SCANPY_PCA.out.adata
                        .map { _meta, h5ad -> h5ad }
                        .collect()
                    input[1] = 'inner'      // join
                    input[2] = 'library_id' // label
                    input[3] = false        // preserve_spatial
                    input[4] = ''           // layer
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = ADATA_MERGE.out.adata
                    .map { h5ad -> [[id: "harmony"], h5ad] }
                input[1] = 'library_id'   // key
                input[2] = 'X_pca_merged' // basis
                input[3] = 'X_harmony'    // embedding_added
                input[4] = true           // write_adata
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    anndata(process.out.adata[0][1]).yaml,
                    process.out.obsm.collect { _, path -> file(path).name }.sort()
                ).match() }
            )
        }
    }

    test("homo_sapiens - h5ad - no h5ad output") {

        setup {
            run("SCANPY_PCA") {
                script "../../pca/main.nf"
                process {
                    """
                    input[0] = channel.fromList([
                        tuple([ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)),
                        tuple([ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2.2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true))
                    ])
                    input[1] = 50      // n_pcs
                    input[2] = false   // use_highly_variable
                    input[3] = 'X_pca' // key_added
                    input[4] = true    // write_adata
                    """
                }
            }
            run("ADATA_MERGE") {
                script "../../../adata/merge/main.nf"
                process {
                    """
                    input[0] = SCANPY_PCA.out.adata
                        .map { _meta, h5ad -> h5ad }
                        .collect()
                    input[1] = 'inner'      // join
                    input[2] = 'library_id' // label
                    input[3] = false        // preserve_spatial
                    input[4] = ''           // layer
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = ADATA_MERGE.out.adata
                    .map { h5ad -> [[id: "harmony"], h5ad] }
                input[1] = 'library_id' // key
                input[2] = 'X_pca'      // basis
                input[3] = 'X_harmony'  // embedding_added
                input[4] = false        // write_adata
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.adata.isEmpty() },
                { assert snapshot(
                    process.out.versions,
                    process.out.obsm.collect { _, path -> file(path).name }.sort()
                ).match() }
            )
        }
    }

    test("homo_sapiens - h5ad - should fail without PCA") {

        setup {
            run("ADATA_MERGE") {
                script "../../../adata/merge/main.nf"
                process {
                    """
                    input[0] = channel.fromList([
                        tuple([ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)),
                        tuple([ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2.2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true))
                    ])
                        .map { _meta, h5ad -> h5ad }
                        .collect()
                    input[1] = 'inner'      // join
                    input[2] = 'library_id' // label
                    input[3] = false        // preserve_spatial
                    input[4] = ''           // layer
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = ADATA_MERGE.out.adata
                    .map { h5ad -> [[id: "harmony"], h5ad] }
                input[1] = 'library_id' // key
                input[2] = 'X_pca'      // basis
                input[3] = 'X_harmony'  // embedding_added
                input[4] = true         // write_adata
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Embedding 'X_pca' not found in adata.obsm") }
            )
        }
    }

    test("homo_sapiens - h5ad - should fail with missing key") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                ]
                input[1] = 'missing_key' // key
                input[2] = 'X_pca'       // basis
                input[3] = 'X_harmony'   // embedding_added
                input[4] = true          // write_adata
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Integration key 'missing_key' not found in adata.obs") }
            )
        }
    }

    test("homo_sapiens - h5ad - stub") {

        options "-stub"

        setup {
            run("SCANPY_PCA") {
                script "../../pca/main.nf"
                process {
                    """
                    input[0] = channel.fromList([
                        tuple([ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)),
                        tuple([ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2.2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679759_filtered_matrix.h5ad', checkIfExists: true))
                    ])
                    input[1] = 50      // n_pcs
                    input[2] = false   // use_highly_variable
                    input[3] = 'X_pca' // key_added
                    input[4] = true    // write_adata
                    """
                }
            }
            run("ADATA_MERGE") {
                script "../../../adata/merge/main.nf"
                process {
                    """
                    input[0] = SCANPY_PCA.out.adata
                        .map { _meta, h5ad -> h5ad }
                        .collect()
                    input[1] = 'inner'      // join
                    input[2] = 'library_id' // label
                    input[3] = false        // preserve_spatial
                    input[4] = ''           // layer
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = ADATA_MERGE.out.adata
                    .map { h5ad -> [[id: "harmony"], h5ad] }
                input[1] = 'library_id' // key
                input[2] = 'X_pca'      // basis
                input[3] = 'X_harmony'  // embedding_added
                input[4] = true         // write_adata
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
