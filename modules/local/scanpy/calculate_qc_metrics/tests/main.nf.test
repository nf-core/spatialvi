nextflow_process {

    name "Test Process SCANPY_CALCULATE_QC_METRICS"
    script "../main.nf"
    process "SCANPY_CALCULATE_QC_METRICS"

    tag "modules"
    tag "modules_local"
    tag "scanpy_calculate_qc_metrics"

    test("homo_sapiens - h5ad") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("homo_sapiens - h5ad - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
