nextflow_process {

    name "Test Process SDATA_MERGE"
    script "../main.nf"
    process "SDATA_MERGE"

    tag "modules"
    tag "modules_local"
    tag "sdata_merge"

    test("homo_sapiens - h5ad") {

        setup {
            run("UNTAR") {
                script "../../../../nf-core/untar/main.nf"
                process {
                    """
                    input[0] = channel.fromList([
                        tuple([ id: 'test_1' ], file("https://raw.githubusercontent.com/nf-core/test-datasets/spatialtranscriptomics/testdata/human-brain-cancer-11-mm-capture-area-ffpe-2-standard_v2_ffpe_cytassist/outs.tar.gz", checkIfExists: true)),
                        tuple([ id: 'test_2' ], file("https://raw.githubusercontent.com/nf-core/test-datasets/spatialtranscriptomics/testdata/human-brain-cancer-11-mm-capture-area-ffpe-2-standard_v2_ffpe_cytassist/outs.tar.gz", checkIfExists: true))
                    ])
                    """
                }
            }
            run("SDATA_READ_VISIUM") {
                script "../../read_visium/main.nf"
                process {
                    """
                    input[0] = UNTAR.out.untar
                    input[1] = 8 // hd_bin_size
                    """
                }
            }
        }

        when {
            // TODO: Add module test data in SpatialData format, so that setup
            // won't be required
            process {
                """
                input[0] = SDATA_READ_VISIUM.out.sdata
                    .map { _meta, zarr -> zarr }
                    .collect()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    path(process.out.sdata[0]).list().collect { it.getFileName().toString() }.sort()
                ).match() }
            )
        }
    }

    test("homo_sapiens - h5ad - stub") {

        options "-stub"

        setup {
            run("UNTAR") {
                script "../../../../nf-core/untar/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'test' ], file("https://raw.githubusercontent.com/nf-core/test-datasets/spatialtranscriptomics/testdata/human-brain-cancer-11-mm-capture-area-ffpe-2-standard_v2_ffpe_cytassist/outs.tar.gz", checkIfExists: true)
                    ]
                    """
                }
            }
            run("SDATA_READ_VISIUM") {
                script "../../read_visium/main.nf"
                process {
                    """
                    input[0] = UNTAR.out.untar
                    input[1] = 8 // hd_bin_size
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SDATA_READ_VISIUM.out.sdata
                    .map { _meta, zarr -> zarr }
                    .collect()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
