    test("homo_sapiens - pkl - index mismatch") {

        setup {
            run("SCANPY_PCA") {
                script "../../../scanpy/pca/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'SRR28679756' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
