                    """
                    input[0] = SCANPY_NEIGHBORS.out.adata
                    input[1] = 1.0        // resolution
                    input[2] = 'clusters' // key_added
                    input[3] = true       // write_adata
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SCANPY_LEIDEN.out.adata
                    .join(SCANPY_LEIDEN.out.obs)
                    .join(SCANPY_LEIDEN.out.uns)
                    .map { meta, base, obs, uns -> [ meta, base, obs, [], [], [], [], uns ] }
                input[1] = false // allow_missing
                input[2] = false // overwrite
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("`clusters` already exists") }
            )
        }
    }

