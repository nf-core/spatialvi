                    """
                    input[0] = SDATA_TO_LEGACY_ANNDATA.out.adata
                    input[1] = 'grid' // coord_type
                    input[2] = 6      // n_neighs
                    input[3] = true   // write_adata
                    """
                }
            }
            run("SCANPY_PCA") {
                script "../../../scanpy/pca/main.nf"
                process {
                    """
                    input[0] = SQUIDPY_SPATIAL_NEIGHBORS.out.adata
                    input[1] = 50    // n_pcs
                    input[2] = false // use_highly_variable
                    input[3] = true  // write_adata
                    """
                }
            }
            run("SCANPY_NEIGHBORS") {
                script "../../../scanpy/neighbors/main.nf"
                process {
                    """
                    input[0] = SCANPY_PCA.out.adata
                    input[1] = 15      // n_neighbors
                    input[2] = 50      // n_pcs
                    input[3] = 'X_pca' // use_rep
                    input[4] = true    // write_adata
                    """
                }
            }
            run("SCANPY_LEIDEN") {
                script "../../../scanpy/leiden/main.nf"
                process {
                    """
                    input[0] = SCANPY_NEIGHBORS.out.adata
                    input[1] = 1.0        // resolution
                    input[2] = 'clusters' // key_added
                    input[3] = true       // write_adata
                    """
                }
            }
            run("SCANPY_RANK_GENES_GROUPS") {
                script "../../../scanpy/rank_genes_groups/main.nf"
                process {
                    """
                    input[0] = SCANPY_LEIDEN.out.adata
                    input[1] = 'clusters' // groupby
                    input[2] = 'wilcoxon' // method
                    input[3] = false      // write_adata
                    """
                }
            }
            run("SQUIDPY_NHOOD_ENRICHMENT") {
                script "../../../squidpy/nhood_enrichment/main.nf"
                process {
                    """
                    input[0] = SCANPY_LEIDEN.out.adata
                    input[1] = 'clusters' // cluster_key
                    input[2] = true       // write_adata
                    """
                }
            }
            run("SQUIDPY_INTERACTION_MATRIX") {
                script "../../../squidpy/interaction_matrix/main.nf"
                process {
                    """
                    input[0] = SQUIDPY_NHOOD_ENRICHMENT.out.adata
                    input[1] = 'clusters' // cluster_key
                    input[2] = false      // write_adata
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SCANPY_LEIDEN.out.adata
                    .join(SCANPY_RANK_GENES_GROUPS.out.uns)
                    .join(SQUIDPY_NHOOD_ENRICHMENT.out.uns)
                    .join(SQUIDPY_INTERACTION_MATRIX.out.uns)
                    .map { meta, base, rank_uns, nhood_uns, interaction_uns ->
                        [ meta, base, [], [], [], [], [], [ rank_uns, nhood_uns, interaction_uns ].flatten() ]
                    }
                input[1] = false // allow_missing
                input[2] = false // overwrite
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    anndata(process.out.adata[0][1]).yaml
                ).match() }
            )
        }
    }

    test("homo_sapiens - pkl - obsp index mismatch") {

        setup {
            run("SCANPY_PCA") {
                script "../../../scanpy/pca/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'SRR28679756' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                    input[1] = 50    // n_pcs
                    input[2] = false // use_highly_variable
                    input[3] = true  // write_adata
                    """
                }
            }
            run("SCANPY_NEIGHBORS") {
                script "../../../scanpy/neighbors/main.nf"
                process {
                    """
                    input[0] = SCANPY_PCA.out.adata
                    input[1] = 15      // n_neighbors
                    input[2] = 50      // n_pcs
                    input[3] = 'X_pca' // use_rep
                    input[4] = false   // write_adata
                    """
                }
            }
            run("SCANPY_FILTER") {
                script "../../../scanpy/filter/main.nf"
                process {
                    """
                    input[0] = SCANPY_PCA.out.adata
                    input[1] = 50   // min_counts
                    input[2] = 0    // min_genes
                    input[3] = 0    // min_obs
                    input[4] = 100  // mito_threshold
                    input[5] = 0    // ribo_threshold
                    input[6] = 100  // hb_threshold
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SCANPY_FILTER.out.adata
                    .join(SCANPY_NEIGHBORS.out.obsp)
                    .join(SCANPY_NEIGHBORS.out.uns)
                    .map { meta, base, obsp, uns -> [ meta, base, [], [], [], [], obsp, uns ] }
                input[1] = true  // allow_missing (value is not used; graph re-indexing is not allowed)
                input[2] = false // overwrite
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("graphs can't be re-indexed") }
            )
        }
    }

    test("homo_sapiens - pkl - key collision") {

