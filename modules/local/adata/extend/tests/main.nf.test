                    """
                    input[0] = SCANPY_NEIGHBORS.out.adata
                    input[1] = 1.0        // resolution
                    input[2] = 'clusters' // key_added
                    input[3] = false      // write_adata
                    """
                }
            }
            run("SCANPY_FILTER") {
                script "../../../scanpy/filter/main.nf"
                process {
                    """
                    input[0] = SCANPY_NEIGHBORS.out.adata
                    input[1] = 50   // min_counts
                    input[2] = 0    // min_genes
                    input[3] = 0    // min_obs
                    input[4] = 100  // mito_threshold
                    input[5] = 0    // ribo_threshold
                    input[6] = 100  // hb_threshold
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SCANPY_FILTER.out.adata
                    .join(SCANPY_LEIDEN.out.obs)
                    .join(SCANPY_LEIDEN.out.uns)
                    .map { meta, base, obs, uns -> [ meta, base, obs, [], [], [], [], uns ] }
                input[1] = false // allow_missing
                input[2] = false // overwrite
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Index for obs.clusters differs from adata") }

            )
        }
    }

    test("homo_sapiens - pkl - index mismatch reindexed") {

        setup {
            run("SCANPY_PCA") {
                script "../../../scanpy/pca/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'SRR28679756' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                    input[1] = 50    // n_pcs
                    input[2] = false // use_highly_variable
                    input[3] = true  // write_adata
                    """
                }
            }
            run("SCANPY_NEIGHBORS") {
                script "../../../scanpy/neighbors/main.nf"
                process {
                    """
                    input[0] = SCANPY_PCA.out.adata
                    input[1] = 15      // n_neighbors
                    input[2] = 50      // n_pcs
                    input[3] = 'X_pca' // use_rep
                    input[4] = true    // write_adata
                    """
                }
            }
            run("SCANPY_LEIDEN") {
                script "../../../scanpy/leiden/main.nf"
                process {
                    """
                    input[0] = SCANPY_NEIGHBORS.out.adata
                    input[1] = 1.0        // resolution
                    input[2] = 'clusters' // key_added
                    input[3] = false      // write_adata
                    """
                }
            }
            run("SCANPY_FILTER") {
                script "../../../scanpy/filter/main.nf"
                process {
                    """
                    input[0] = SCANPY_NEIGHBORS.out.adata
                    input[1] = 50   // min_counts
                    input[2] = 0    // min_genes
                    input[3] = 0    // min_obs
                    input[4] = 100  // mito_threshold
                    input[5] = 0    // ribo_threshold
                    input[6] = 100  // hb_threshold
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SCANPY_FILTER.out.adata
                    .join(SCANPY_LEIDEN.out.obs)
                    .join(SCANPY_LEIDEN.out.uns)
                    .map { meta, base, obs, uns -> [ meta, base, obs, [], [], [], [], uns ] }
                input[1] = true  // allow_missing
                input[2] = false // overwrite
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    anndata(process.out.adata[0][1]).yaml
                ).match() }
            )
        }
    }

    test("homo_sapiens - pkl - duplicate names reindexed") {

        setup {
            run("DUPLICATE_VAR_NAMES") {
                script "../../../../../tests/helpers/duplicate_var_names.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'SRR28679756' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                    """
                }
            }
            run("SCANPY_CALCULATE_QC_METRICS") {
                script "../../../scanpy/calculate_qc_metrics/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'SRR28679756' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                    input[1] = false // write_adata
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = DUPLICATE_VAR_NAMES.out.adata
                    .join(SCANPY_CALCULATE_QC_METRICS.out.var)
                    .map { meta, base, var -> [ meta, base, [], var, [], [], [], [] ] }
                input[1] = true  // allow_missing
                input[2] = false // overwrite
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Can't re-index var.qc_metrics") }
            )
        }
    }

