    test("homo_sapiens - pkl - spatial obsp and uns") {

        setup {
            run("UNTAR") {
                script "../../../../nf-core/untar/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file("https://raw.githubusercontent.com/nf-core/test-datasets/spatialvi/testdata/human-brain-cancer-11-mm-capture-area-ffpe-2-standard_v2_ffpe_cytassist/outs.tar.gz", checkIfExists: true)
                    ]
                    """
                }
            }
            run("SDATA_READ_VISIUM") {
                script "../../../sdata/read_visium/main.nf"
                process {
                    """
                    input[0] = UNTAR.out.untar
                    input[1] = 8 // hd_bin_size
                    """
                }
            }
            run("SDATA_TO_LEGACY_ANNDATA") {
                script "../../../sdata/to_legacy_anndata/main.nf"
                process {
                    """
                    input[0] = SDATA_READ_VISIUM.out.sdata
                    """
                }
            }
            run("SQUIDPY_SPATIAL_NEIGHBORS") {
                script "../../../squidpy/spatial_neighbors/main.nf"
                process {
                    """
                    input[0] = SDATA_TO_LEGACY_ANNDATA.out.adata
                    input[1] = 'grid' // coord_type
                    input[2] = 6      // n_neighs
                    input[3] = true   // write_adata
                    """
                }
            }
            run("SQUIDPY_SPATIAL_AUTOCORR") {
                script "../../../squidpy/spatial_autocorr/main.nf"
                process {
                    """
                    input[0] = SQUIDPY_SPATIAL_NEIGHBORS.out.adata
                    input[1] = 'moran' // mode
                    input[2] = false   // write_adata
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SDATA_TO_LEGACY_ANNDATA.out.adata
                    .join(SQUIDPY_SPATIAL_NEIGHBORS.out.obsp)
                    .join(SQUIDPY_SPATIAL_NEIGHBORS.out.uns)
                    .join(SQUIDPY_SPATIAL_AUTOCORR.out.uns)
                    .map { meta, base, obsp, neighbors_uns, autocorr_uns ->
                        [ meta, base, [], [], [], [], obsp, [ neighbors_uns, autocorr_uns ].flatten() ]
                    }
                input[1] = false // allow_missing
                input[2] = false // overwrite
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    anndata(process.out.adata[0][1]).yaml
                ).match() }
            )
        }
    }

    test("homo_sapiens - pkl - uns from several modules") {

        setup {
            run("UNTAR") {
                script "../../../../nf-core/untar/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file("https://raw.githubusercontent.com/nf-core/test-datasets/spatialvi/testdata/human-brain-cancer-11-mm-capture-area-ffpe-2-standard_v2_ffpe_cytassist/outs.tar.gz", checkIfExists: true)
