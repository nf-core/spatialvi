nextflow_process {

    name "Test Process ADATA_EXTEND"
    script "../main.nf"
    process "ADATA_EXTEND"

    tag "modules"
    tag "modules_local"
    tag "adata_extend"

    test("homo_sapiens - pkl - obs and uns") {

        setup {
            run("SCANPY_PCA") {
                script "../../../scanpy/pca/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'SRR28679756' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                    input[1] = 50    // n_pcs
                    input[2] = false // use_highly_variable
                    input[3] = true  // write_adata
                    """
                }
            }
            run("SCANPY_NEIGHBORS") {
                script "../../../scanpy/neighbors/main.nf"
                process {
                    """
                    input[0] = SCANPY_PCA.out.adata
                    input[1] = 15      // n_neighbors
                    input[2] = 50      // n_pcs
                    input[3] = 'X_pca' // use_rep
                    input[4] = true    // write_adata
                    """
                }
            }
            run("SCANPY_LEIDEN") {
                script "../../../scanpy/leiden/main.nf"
                process {
                    """
                    input[0] = SCANPY_NEIGHBORS.out.adata
                    input[1] = 1.0        // resolution
                    input[2] = 'clusters' // key_added
                    input[3] = false      // write_adata
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SCANPY_NEIGHBORS.out.adata
                    .join(SCANPY_LEIDEN.out.obs)
                    .join(SCANPY_LEIDEN.out.uns)
                    .map { meta, base, obs, uns -> [ meta, base, obs, [], [], [], [], uns ] }
                input[1] = false // allow_missing
                input[2] = false // overwrite
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    anndata(process.out.adata[0][1]).yaml
                ).match() }
            )
        }
    }

    test("homo_sapiens - pkl - obsm, varm and uns") {

        setup {
            run("SCANPY_PCA") {
                script "../../../scanpy/pca/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                    input[1] = 50    // n_pcs
                    input[2] = false // use_highly_variable
                    input[3] = false // write_adata
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = channel.of([
                        [ id: 'CytAssist_11mm_FFPE_Human_Glioblastoma_2' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ])
                    .join(SCANPY_PCA.out.obsm)
                    .join(SCANPY_PCA.out.varm)
                    .join(SCANPY_PCA.out.uns)
                    .map { meta, base, obsm, varm, uns -> [ meta, base, [], [], obsm, varm, [], uns ] }
                input[1] = false // allow_missing
                input[2] = false // overwrite
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    anndata(process.out.adata[0][1]).yaml
                ).match() }
            )
        }
    }

