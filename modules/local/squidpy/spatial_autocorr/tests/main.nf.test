nextflow_process {

    name "Test Process SQUIDPY_SPATIAL_AUTOCORR"
    script "../main.nf"
    process "SQUIDPY_SPATIAL_AUTOCORR"

    tag "modules"
    tag "modules_local"
    tag "squidpy_spatial_autocorr"

    test("homo_sapiens - h5ad") {

        setup {
            run("UNTAR") {
                script "../../../../nf-core/untar/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'test' ], file("https://raw.githubusercontent.com/nf-core/test-datasets/spatialvi/testdata/human-brain-cancer-11-mm-capture-area-ffpe-2-standard_v2_ffpe_cytassist/outs.tar.gz", checkIfExists: true)
                    ]
                    """
                }
            }
            run("SDATA_READ_VISIUM") {
                script "../../../sdata/read_visium/main.nf"
                process {
                    """
                    input[0] = UNTAR.out.untar
                    input[1] = 8 // hd_bin_size
                    """
                }
            }
            run("SDATA_TO_LEGACY_ANNDATA") {
                script "../../../sdata/to_legacy_anndata/main.nf"
                process {
                    """
                    input[0] = SDATA_READ_VISIUM.out.sdata
                    """
                }
            }
            run("SQUIDPY_SPATIAL_NEIGHBORS") {
                script "../../spatial_neighbors/main.nf"
                process {
                    """
                    input[0] = SDATA_TO_LEGACY_ANNDATA.out.adata
                    input[1] = 'grid' // coord_type
                    input[2] = 6      // n_neighs
                    """
                }
            }
        }

        when {
            // TODO: Add a SpatialData test dataset, so some setup can be
            // skipped
            process {
                """
                input[0] = SQUIDPY_SPATIAL_NEIGHBORS.out.adata
                input[1] = 'moran' // mode
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    anndata(process.out.adata[0][1]).yaml
                ).match() },
                { assert path(process.out.csv[0][1]).readLines().size() == 19024}
            )
        }
    }

    test("homo_sapiens - h5ad - stub") {

        options "-stub"

        setup {
            run("UNTAR") {
                script "../../../../nf-core/untar/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'test' ], file("https://raw.githubusercontent.com/nf-core/test-datasets/spatialvi/testdata/human-brain-cancer-11-mm-capture-area-ffpe-2-standard_v2_ffpe_cytassist/outs.tar.gz", checkIfExists: true)
                    ]
                    """
                }
            }
            run("SDATA_READ_VISIUM") {
                script "../../../sdata/read_visium/main.nf"
                process {
                    """
                    input[0] = UNTAR.out.untar
                    input[1] = 8 // hd_bin_size
                    """
                }
            }
            run("SDATA_TO_LEGACY_ANNDATA") {
                script "../../../sdata/to_legacy_anndata/main.nf"
                process {
                    """
                    input[0] = SDATA_READ_VISIUM.out.sdata
                    """
                }
            }
            run("SQUIDPY_SPATIAL_NEIGHBORS") {
                script "../../spatial_neighbors/main.nf"
                process {
                    """
                    input[0] = SDATA_TO_LEGACY_ANNDATA.out.adata
                    input[1] = 'grid' // coord_type
                    input[2] = 6      // n_neighs
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SQUIDPY_SPATIAL_NEIGHBORS.out.adata
                input[1] = 'moran' // mode
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
