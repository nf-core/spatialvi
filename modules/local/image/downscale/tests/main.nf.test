nextflow_process {

    name "Test Process IMAGE_DOWNSCALE"
    script "../main.nf"
    process "IMAGE_DOWNSCALE"

    tag "modules"
    tag "modules_local"
    tag "image_downscale"

    test("homo_sapiens - tif - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'Visium_HD_Human_Lung_Cancer_HD_Only_Experiment2' ], file(params.pipelines_testdata_base_path + 'testdata/human-lung-cancer-post-xenium_hd_ffpe/Visium_HD_Human_Lung_Cancer_HD_Only_Experiment2_image.tif', checkIfExists: true)
                ]
                input[1] = 2 // downscale
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
