nextflow_process {

    name "Test Process MASK_TO_GEOJSON"
    script "../main.nf"
    process "MASK_TO_GEOJSON"

    tag "modules"
    tag "modules_local"
    tag "mask_to_geojson"

    test("homo_sapiens - tif - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'Visium_HD_Human_Lung_Cancer_HD_Only_Experiment2' ], file(params.pipelines_testdata_base_path + 'testdata/human-lung-cancer-post-xenium_hd_ffpe/Visium_HD_Human_Lung_Cancer_HD_Only_Experiment2_image.tif', checkIfExists: true)
                ]
                input[1] = 2         // scale
                input[2] = 'nucleus' // object_class
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
