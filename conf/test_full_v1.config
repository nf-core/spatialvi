/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/spatialvi -profile test_full_v1,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile (Space Ranger v1)'
    config_profile_description = 'Full test dataset to check pipeline function - Human Ovarian Cancer 1, FFPE, v1 chemistry'

    // Input data for full size test
    // FASTQs, image and slide files are streamed directly from 10x Genomics;
    // only the (tiny) samplesheet is hosted on the nf-core test-datasets repo.
    input                = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/spatialvi/testdata/human-ovarian-cancer-1-standard_v1_ffpe/samplesheet_full.csv'
    spaceranger_probeset = 'https://cf.10xgenomics.com/samples/spatial-exp/1.3.0/Visium_FFPE_Human_Ovarian_Cancer/Visium_FFPE_Human_Ovarian_Cancer_probe_set.csv'
    // spaceranger_reference uses the pipeline default: refdata-gex-GRCh38-2020-A.tar.gz
}
