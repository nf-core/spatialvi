nextflow_pipeline {
    name "Test full HD workflow (incl. Space Ranger v1)"
    script "main.nf"
    tag "pipeline"
    profile "test_spaceranger_hd"

    test("Space Ranger FFPE HD") {
        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {

            // Names of all output files and directories (unstable contents)
            def stable_name = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: ['pipeline_info/*.{html,json,txt}', '**/*.zarr/**']
            )

            // Names of all SpatialData (.zarr) files and directories (unstable contents)
            def stable_name_zarr = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                include: ['**/*.zarr/**']
            )

            // Paths of all output files (stable contents)
            def stable_path = getAllFilesFromDir(
                params.outdir,
                ignoreFile: 'tests/.nftignore'
            )

            // Paths of all output AnnData files (unstable contents)
            def adata_files = getAllFilesFromDir(
                params.outdir,
                include: ['**/*.h5ad']
            )

            assertAll(

                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // Pipeline versions.yml file for multiqc from which Nextflow version is removed because we tests pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_spatialvi_software_mqc_versions.yml"),
                    stable_name,
                    stable_name_zarr,
                    stable_path,
                    // AnnData files parsed into YAML format
                    adata_files.collect { file -> anndata(file.toPath()).yaml }
                ).match() }

            )
        }
    }
}
