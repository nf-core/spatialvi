nextflow_pipeline {

    name "Test downstream workflow (excl. Space Ranger)"
    script "../main.nf"
    tag "pipeline"
    profile "test_downstream"

    test("Downstream FFPE v2 CytAssist") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {

            // Names of all output files and directories with stable_name contents
            def stable_name = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: ['pipeline_info/*.{html,json,txt}']
            ).sort()

            // Paths of all output files with stable_path contents
            def stable_path = getAllFilesFromDir(
                params.outdir,
                ignoreFile: 'tests/.nftignore'
            )

            // Paths of all output AnnData files
            def adata_files = getAllFilesFromDir(
                params.outdir,
                include: ['**/*.h5ad']
            )

            // Test sample names
            def sample = "CytAssist_11mm_FFPE_Human_Glioblastoma_2"

            assertAll(

                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we tests pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_spatialvi_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path,
                    // AnnData files with unstable content
                    adata_files.collect { file -> anndata(file.toPath()).yaml }
                ).match() }

            )
        }
    }
}
