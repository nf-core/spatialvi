nextflow_pipeline {

    name "Test downstream workflow (excl. Space Ranger)"
    script "../main.nf"
    tag "pipeline"
    profile "test_downstream"

    test("Downstream FFPE v2 CytAssist") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {

            // Names of all output files and directories with unstable contents
            def unstable = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: ['pipeline_info/*.{html,json,txt}']
            )

            // Paths of all output files with stable contents
            def stable = getAllFilesFromDir(
                params.outdir,
                ignoreFile: 'tests/.nftignore'
            )

            // Test sample names
            def sample = "CytAssist_11mm_FFPE_Human_Glioblastoma_2"

            assertAll(

                { assert workflow.success},
                { assert snapshot(unstable, stable).match() }

                // Remove Nextflow versions since testing is done on several versions
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/nf_core_spatialvi_software_mqc_versions.yml")).match() },

                // Report contents
                { assert file ("${outputDir}/${sample}/reports/report-${sample}.html").text.contains("Spatially variable genes")}
                { assert file ("${outputDir}/${sample}.2/reports/report-${sample}.2.html").text.contains("Spatially variable genes")}
                { assert file ("${outputDir}/integration/reports/report-integrated.html").text.contains("Spatial visualization")}

            )
        }
    }
}
